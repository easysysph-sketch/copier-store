# CopierStore production environment
FLASK_ENV=production
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=1

# REQUIRED: generate a unique random value of at least 32 characters.
SECRET_KEY=replace-with-a-long-random-secret

# REQUIRED: create a strong admin username/password for deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Optional emergency recovery key used by the admin recovery flow.
ADMIN_RECOVERY_KEY=replace-with-a-long-random-recovery-key

# Optional AI support. Leave blank if AI features are not needed.
GEMINI_API_KEY=

# Optional Lalamove integration. Use production credentials only when ready.
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_ENV=production
LALAMOVE_MARKET=PH
LALAMOVE_SERVICE_TYPE=MOTORCYCLE
LALAMOVE_PICKUP_NAME=CopierStore
LALAMOVE_PICKUP_PHONE=
LALAMOVE_PICKUP_ADDRESS=CopierStore, Cebu City, Philippines
STORE_LATITUDE=10.3157
STORE_LONGITUDE=123.8854

# Optional courier capacity guard. Leave blank to allow manual/larger-vehicle handling.
LALAMOVE_MAX_WEIGHT_KG=
LALAMOVE_MAX_LENGTH_CM=
LALAMOVE_MAX_WIDTH_CM=
LALAMOVE_MAX_HEIGHT_CM=
